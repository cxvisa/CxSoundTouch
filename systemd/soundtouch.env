# Settings for the soundtouch service (see README.md). Restart it after a change:
#   sudo systemctl restart soundtouch

# Push song titles this many seconds earlier (negative) or later than the station's title change.
# -3.1 suits the K-LOVE family of stations, which change the title about 3 s after the song starts.
SOUNDTOUCH_TITLE_OFFSET=-3.1

# How much of the stream the relay keeps, in MB (2-512): how long a pause can carry on exactly.
#SOUNDTOUCH_RELAY_BUFFER=16

# The relay's port, if 8899 is taken.
#SOUNDTOUCH_RELAY_PORT=8899

# Further control options, e.g. --no-resume.
SOUNDTOUCH_OPTIONS=
