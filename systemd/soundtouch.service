# cxstcc control as a system service: starts at boot, comes back if it dies.
# How to install it: systemd/README.md (or: make && sudo make install install-service).
#
# Settings are in /etc/soundtouch/soundtouch.env. streams.json, devices.json and state.json live in
# /var/lib/soundtouch (really /var/lib/private/soundtouch, as DynamicUser= arranges).

[Unit]
Description=Cloud-free control for a Bose SoundTouch speaker
Documentation=https://github.com/cxvisa/CxSoundTouch30
# The relay hands the speaker this host's address, so the network has to be up first.
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
Environment=SOUNDTOUCH_DATA_DIR=/var/lib/soundtouch
EnvironmentFile=-/etc/soundtouch/soundtouch.env
ExecStart=/usr/local/bin/cxstcc control --update-track-info $SOUNDTOUCH_OPTIONS

# SIGTERM stops it cleanly in well under a second; a second signal quits at once.
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Its own unprivileged user, with nothing but its state directory writable.
DynamicUser=yes
StateDirectory=soundtouch
UMask=0077
ProtectHome=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
